# Copy this file to `.env.local` (which is gitignored) and paste your key.
# Get one at https://aistudio.google.com/apikey — a free-tier key works for
# light testing; heavy dev will want the pay-per-token key.
#
# Vite reads this file on startup only, so restart `npm run dev` after editing.
GEMINI_API_KEY=your-gemini-api-key-here
